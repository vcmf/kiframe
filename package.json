{
  "name": "kiframe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kiframe/agent": "workspace:*",
    "@kiframe/compositor": "workspace:*",
    "@kiframe/generators": "workspace:*",
    "@kiframe/project": "workspace:*",
    "@kiframe/runtime": "workspace:*",
    "@kiframe/schema": "workspace:*",
    "@kiframe/studio": "workspace:*",
    "@kiframe/vault": "workspace:*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "29.1.1",
    "openai": "7.23.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
